[Unit]
Description=Wasteland Builder arena WebSocket relay
After=network.target

[Service]
Type=simple
User=wasteland-arena
Group=wasteland-arena
WorkingDirectory=/opt/wasteland-arena
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5221
Environment=ALLOWED_ORIGINS=__ALLOWED_ORIGINS__
ExecStart=/usr/bin/node /opt/wasteland-arena/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
