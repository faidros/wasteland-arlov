# Site block appended to /etc/caddy/Caddyfile when the server already runs Caddy on 80/443.
# Caddy obtains the TLS certificate itself and proxies the WebSocket upgrade. Other site blocks stay untouched.
__ARENA_DOMAIN__ {
	handle /ws {
		reverse_proxy 127.0.0.1:5221 {
			stream_close_delay 5m
		}
	}
	handle /health {
		reverse_proxy 127.0.0.1:5221
	}
	handle {
		respond 404
	}
}
