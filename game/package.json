{
  "name": "wasteland-battlecars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arena": "node server/index.mjs",
    "dev": "vite --host 0.0.0.0 --port 5220",
    "build": "vite build && node deploy/prepare-web.mjs",
    "vercel-build": "node deploy/prepare-city-for-vercel.mjs && vite build && node deploy/prepare-web.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5220",
    "models": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --factory-startup --python tools/build-vehicles.py",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  },
  "description": "Mad Max-style battle-car game that drives any city generated by wasteland-builder (public/city/)."
}
